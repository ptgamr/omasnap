#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
prefix="${OMASNAP_PREFIX:-$HOME/.local}"
build_dir="${XDG_CACHE_HOME:-$HOME/.cache}/omasnap/build"

if ! command -v omarchy-pkg-add >/dev/null; then
  printf 'install-omarchy: omarchy-pkg-add is unavailable; this installer requires Omarchy\n' >&2
  exit 1
fi

omarchy-pkg-add \
  base-devel cmake ninja pkgconf qt6-base layer-shell-qt \
  wayland wayland-protocols wl-clipboard \
  tesseract tesseract-data-eng \
  qt6-multimedia gpu-screen-recorder ffmpeg

cmake -S "$repo_dir" -B "$build_dir" -G Ninja \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX="$prefix"
cmake --build "$build_dir" --parallel
cmake --install "$build_dir"

"$prefix/bin/omasnap" --version
"$prefix/bin/omasnap-studio" --version

cat <<'NOTE'

To keep the recording indicator out of your recordings, add this layer rule to
your own Hyprland Lua config (this installer does not edit it for you):

  hl.layer_rule({
    match = { namespace = "^omasnap-record$" },
    no_anim = true,
    animation = "none",
    no_screen_share = true,
  })

NOTE
